<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Legion.Physics - the engine-agnostic physics backend seam (ILegionPhysicsBackend).

    MILESTONE 1: self-contained. This library links NEITHER OpenSim NOR BulletSim and is
    NOT a selectable [Startup] physics module yet. It builds to its OWN local bin\, kept
    deliberately out of the shared ..\..\..\..\bin\ so it cannot touch the running grid's
    physics selection. Output target changes only when it becomes `physics = Jolt` (M6).

    Csproj is hand-maintained (Legion convention): EnableDefaultItems is OFF, every .cs
    needs an explicit <Compile Include>. Do NOT run runprebuild against this tree.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>Legion.Physics</AssemblyName>
    <RootNamespace>Legion.Physics</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultItems>false</EnableDefaultItems>
    <Deterministic>true</Deterministic>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><!-- 2.19.x HeightFieldShapeSettings takes float* -->
    <NoWarn>$(NoWarn);CS0168</NoWarn>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Local bin only. Default SDK output (bin\<Config>\net8.0\) is already project-local;
         we intentionally do NOT redirect to the shared OpenSim bin this milestone. -->
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="ILegionPhysicsBackend.cs" />
    <Compile Include="JoltPhysicsBackend.cs" />
  </ItemGroup>

  <!-- M1 Task 2: Jolt binding. net8.0 support runs through 2.19.1 (dropped at 2.19.2 -> net9/net10
       only). 2.19.1 is the newest net8.0-compatible release; it pulls the matching native
       JoltPhysics.Native 1.0.4 (2.18.6 pulled 1.0.3). Native joltc.dll ships in the JoltPhysics.Native
       dependency under runtimes/<rid>/native/; single precision (joltc.dll) is the default load,
       double (joltc_double.dll) is opt-in - decision #2 is closed on single.
       [M7 boot-hang] bumped 2.18.6 -> 2.19.1 to pick up native 1.0.4 for the frame-0 welded-compound-
       vs-heightfield Update spin; stays net8.0 (a net9/net10-only 2.22.0 can't load in OpenSim's net8
       runtime). Re-validate M6.8 parity on the new native before promoting off scratch. -->
  <ItemGroup>
    <PackageReference Include="JoltPhysicsSharp" Version="2.19.1" />
  </ItemGroup>

</Project>
