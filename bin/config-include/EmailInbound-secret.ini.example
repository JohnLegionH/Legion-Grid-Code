; Email inbound IMAP credentials (T2 — external -> object mail).
;
; Copy this file to  config-include/EmailInbound-secret.ini  and fill in the real
; credentials. The real file is gitignored and must NEVER be committed.
;
; Reference it from OpenSim.ini (after the [SMTP] block's own settings) with:
;     Include-EmailInbound = "config-include/EmailInbound-secret.ini"
;
; Nini merges these keys into the [SMTP] section, alongside the non-secret IMAP_*
; keys you set directly in OpenSim.ini (IMAP_inbound_enabled, IMAP_SERVER_HOSTNAME,
; IMAP_SERVER_PORT, IMAP_SERVER_TLS, IMAP_PollInterval, IMAP_Folder, IMAP_DeleteRouted).
;
; Only the sensitive values belong here. For an auth-less test server (e.g. smtp4dev)
; leave both blank.

[SMTP]
    IMAP_SERVER_LOGIN = ""
    IMAP_SERVER_PASSWORD = ""
